#!/bin/sh
# wan6 固定 IPv6 后缀 a1b2:c3d4:e5f7 (地址由 netifd 托管在 lan 接口, eth0 与 wan6 共用)
# 跟随光猫下发的全局 /64 前缀: <prefix>::a1b2:c3d4:e5f7/64
# 由 wan6 的 ifup / ifupdate(RA 更新、renew) 事件触发

[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0
[ "$INTERFACE" = "wan6" ] || exit 0

DEV=eth0
SUFFIX='a1b2:c3d4:e5f7'

# 当前 /64 前缀: 优先取 RA 的 on-link 路由; 缺失时从 wan6 的 DHCPv6 全局 /128 地址推导
PFX=$(ip -6 route show dev "$DEV" 2>/dev/null | awk '$1 ~ /^[23]/ && $1 ~ /\/64$/ {print $1; exit}')
if [ -z "$PFX" ]; then
    A128=$(ip -6 addr show dev "$DEV" scope global 2>/dev/null | \
        awk '$2 ~ /\/128$/ && $2 ~ /^[23]/ {print $2; exit}' | cut -d/ -f1)
    [ -n "$A128" ] || exit 0
    PFX="$(echo "$A128" | awk -F: '{print $1":"$2":"$3":"$4}')::/64"
fi

BASE=${PFX%/*}
WANT="${BASE}${SUFFIX}/64"

# /64 前缀的全展开形式(补齐 4 组, 用于与 ip addr 的压缩输出比对)
PFXFULL=$(echo "$PFX" | sed -e 's|/64$||' -e 's|::$||' | \
    awk -F: '{printf "%s:%s:%s:%s", $1, ($2!=""?$2:"0"), ($3!=""?$3:"0"), ($4!=""?$4:"0")}')
WANTK="${PFXFULL}:0:${SUFFIX}/64"

# --- 同步 UCI(lan 的 ip6addr 列表): 移除旧前缀条目, 补上新条目 ---
CHANGED=0
HAS=0
for a in $(uci -q show network.lan.ip6addr 2>/dev/null | sed -e "s/^network\.lan\.ip6addr=//" -e "s/'//g" | tr ' ' '\n'); do
    case "$a" in
        fe80*) continue ;;
        *$SUFFIX*)
            if [ "$a" = "$WANT" ]; then
                HAS=1
            else
                uci -q del_list network.lan.ip6addr="$a"; CHANGED=1
            fi ;;
    esac
done
[ "$HAS" = 0 ] && { uci -q add_list network.lan.ip6addr="$WANT"; CHANGED=1; }

if [ "$CHANGED" = 1 ]; then
    uci commit network
    ubus call network reload
    sleep 3
fi

# --- 内核兜底: 先清理残留(与当前前缀不符的固定后缀地址), 再确保目标地址在位 ---
for old in $(ip -6 addr show dev "$DEV" scope global 2>/dev/null | awk '/inet6/ && /a1b2:c3d4:e5f7/ {print $2}'); do
    [ "$old" = "$WANTK" ] || ip -6 addr del "$old" dev "$DEV" 2>/dev/null
done
ip -6 addr show dev "$DEV" 2>/dev/null | grep -qF "$WANTK" || \
    ip -6 addr replace "$WANT" dev "$DEV" 2>/dev/null
